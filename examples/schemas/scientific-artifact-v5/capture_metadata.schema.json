{
  "$id": "capture_metadata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict metadata required to classify frames for one Ethernet capture.",
  "properties": {
    "interface": {
      "const": "eth0",
      "title": "Interface",
      "type": "string"
    },
    "target_mac": {
      "title": "Target Mac",
      "type": "string"
    }
  },
  "required": [
    "interface",
    "target_mac"
  ],
  "title": "CaptureMetadata",
  "type": "object"
}
