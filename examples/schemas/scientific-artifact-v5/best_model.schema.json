{
  "$defs": {
    "AcdDiagnosticsPayload": {
      "additionalProperties": false,
      "properties": {
        "converged": {
          "const": true,
          "title": "Converged",
          "type": "boolean"
        },
        "final_negative_log_likelihood": {
          "$ref": "#/$defs/ExactFloat"
        },
        "initial_conditional_duration": {
          "$ref": "#/$defs/PositiveFloat"
        },
        "iterations": {
          "maximum": 500,
          "minimum": 0,
          "title": "Iterations",
          "type": "integer"
        }
      },
      "required": [
        "initial_conditional_duration",
        "final_negative_log_likelihood",
        "iterations",
        "converged"
      ],
      "title": "AcdDiagnosticsPayload",
      "type": "object"
    },
    "AcdPayload": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "$ref": "#/$defs/FloatVector"
        },
        "beta": {
          "$ref": "#/$defs/FloatVector"
        },
        "diagnostics": {
          "$ref": "#/$defs/AcdDiagnosticsPayload"
        },
        "marks": {
          "$ref": "#/$defs/MarkPayloads"
        },
        "omega": {
          "$ref": "#/$defs/PositiveFloat"
        }
      },
      "required": [
        "omega",
        "alpha",
        "beta",
        "diagnostics",
        "marks"
      ],
      "title": "AcdPayload",
      "type": "object"
    },
    "ContentIdentity": {
      "description": "The portable size and SHA-256 identity of authoritative bytes.",
      "properties": {
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "size",
        "sha256"
      ],
      "title": "ContentIdentity",
      "type": "object"
    },
    "DirectionName": {
      "enum": [
        "outbound",
        "inbound"
      ],
      "type": "string"
    },
    "ExactFloat": {
      "type": "number"
    },
    "FamilyPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/PoissonPayload"
        },
        {
          "$ref": "#/$defs/MarkovRenewalPayload"
        },
        {
          "$ref": "#/$defs/MmppPayload"
        },
        {
          "$ref": "#/$defs/NhppPayload"
        },
        {
          "$ref": "#/$defs/AcdPayload"
        },
        {
          "$ref": "#/$defs/MarkovPacketTrainPayload"
        },
        {
          "$ref": "#/$defs/PacketHmmPayload"
        }
      ]
    },
    "FloatBounds": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "FloatBounds",
      "type": "object"
    },
    "FloatCube": {
      "items": {
        "$ref": "#/$defs/FloatMatrix"
      },
      "type": "array"
    },
    "FloatMatrix": {
      "items": {
        "$ref": "#/$defs/FloatVector"
      },
      "type": "array"
    },
    "FloatVector": {
      "items": {
        "$ref": "#/$defs/ExactFloat"
      },
      "type": "array"
    },
    "Gene": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        }
      ]
    },
    "GenerationLimits": {
      "additionalProperties": false,
      "properties": {
        "max_output_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_packets": {
          "exclusiveMinimum": 0,
          "title": "Max Packets",
          "type": "integer"
        },
        "max_wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "max_packets",
        "max_output_bytes",
        "max_wall_seconds"
      ],
      "title": "GenerationLimits",
      "type": "object"
    },
    "Genes": {
      "items": {
        "$ref": "#/$defs/Gene"
      },
      "type": "array"
    },
    "IntVector": {
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "IntegerBounds": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "integer"
        },
        "upper": {
          "title": "Upper",
          "type": "integer"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "IntegerBounds",
      "type": "object"
    },
    "MarkPayload": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "$ref": "#/$defs/PositiveInt"
        },
        "direction": {
          "$ref": "#/$defs/DirectionName"
        },
        "frame_length": {
          "maximum": 4294967295,
          "minimum": 14,
          "title": "Frame Length",
          "type": "integer"
        }
      },
      "required": [
        "direction",
        "frame_length",
        "count"
      ],
      "title": "MarkPayload",
      "type": "object"
    },
    "MarkPayloadLists": {
      "items": {
        "$ref": "#/$defs/MarkPayloads"
      },
      "type": "array"
    },
    "MarkPayloads": {
      "items": {
        "$ref": "#/$defs/MarkPayload"
      },
      "type": "array"
    },
    "MarkovPacketTrainPayload": {
      "additionalProperties": false,
      "properties": {
        "conditional_inter_train_gaps": {
          "$ref": "#/$defs/FloatCube"
        },
        "gap_quantile": {
          "$ref": "#/$defs/ExactFloat",
          "const": 0.9
        },
        "gap_threshold": {
          "$ref": "#/$defs/NonnegativeFloat"
        },
        "global_inter_train_gaps": {
          "$ref": "#/$defs/FloatVector"
        },
        "initial_probabilities": {
          "$ref": "#/$defs/FloatVector"
        },
        "inside_train_endpoint": {
          "const": "less_than_or_equal",
          "title": "Inside Train Endpoint",
          "type": "string"
        },
        "length_cap": {
          "maximum": 8,
          "minimum": 3,
          "title": "Length Cap",
          "type": "integer"
        },
        "states": {
          "$ref": "#/$defs/PacketTrainStatePayloads"
        },
        "timing_diagnostics": {
          "$ref": "#/$defs/MarkovTimingPayload"
        },
        "transition_pseudocount": {
          "$ref": "#/$defs/PositiveFloat",
          "const": 1.0
        },
        "transition_rows": {
          "$ref": "#/$defs/FloatMatrix"
        }
      },
      "required": [
        "conditional_inter_train_gaps",
        "gap_quantile",
        "gap_threshold",
        "global_inter_train_gaps",
        "initial_probabilities",
        "inside_train_endpoint",
        "length_cap",
        "states",
        "timing_diagnostics",
        "transition_pseudocount",
        "transition_rows"
      ],
      "title": "MarkovPacketTrainPayload",
      "type": "object"
    },
    "MarkovRenewalPayload": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "$ref": "#/$defs/NonnegativeFloat"
        },
        "conditional_iats": {
          "$ref": "#/$defs/FloatCube"
        },
        "global_iats": {
          "$ref": "#/$defs/FloatVector"
        },
        "minimum_support": {
          "$ref": "#/$defs/PositiveInt"
        },
        "states": {
          "$ref": "#/$defs/MarkovStatePayloads"
        },
        "thresholds": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/ExactFloat"
            },
            {
              "$ref": "#/$defs/ExactFloat"
            }
          ],
          "title": "Thresholds",
          "type": "array"
        },
        "time_scale": {
          "$ref": "#/$defs/PositiveFloat"
        },
        "timing_diagnostics": {
          "$ref": "#/$defs/MarkovTimingPayload"
        },
        "transition_rows": {
          "$ref": "#/$defs/FloatMatrix"
        }
      },
      "required": [
        "alpha",
        "conditional_iats",
        "global_iats",
        "minimum_support",
        "states",
        "thresholds",
        "time_scale",
        "timing_diagnostics",
        "transition_rows"
      ],
      "title": "MarkovRenewalPayload",
      "type": "object"
    },
    "MarkovStatePayload": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/DirectionName"
        },
        "frame_lengths": {
          "$ref": "#/$defs/IntVector"
        },
        "size_bin": {
          "maximum": 2,
          "minimum": 0,
          "title": "Size Bin",
          "type": "integer"
        },
        "source_iats": {
          "$ref": "#/$defs/FloatVector"
        }
      },
      "required": [
        "direction",
        "frame_lengths",
        "size_bin",
        "source_iats"
      ],
      "title": "MarkovStatePayload",
      "type": "object"
    },
    "MarkovStatePayloads": {
      "items": {
        "$ref": "#/$defs/MarkovStatePayload"
      },
      "type": "array"
    },
    "MarkovTimingPayload": {
      "additionalProperties": false,
      "properties": {
        "reference_usage_counts": {
          "$ref": "#/$defs/TimingUsageCountsPayload"
        },
        "transition_tiers": {
          "$ref": "#/$defs/TimingTierMatrix"
        },
        "unobserved_rows": {
          "$ref": "#/$defs/IntVector"
        }
      },
      "required": [
        "reference_usage_counts",
        "transition_tiers",
        "unobserved_rows"
      ],
      "title": "MarkovTimingPayload",
      "type": "object"
    },
    "MmppPayload": {
      "additionalProperties": false,
      "properties": {
        "lambda0": {
          "$ref": "#/$defs/PositiveFloat"
        },
        "lambda1": {
          "$ref": "#/$defs/PositiveFloat"
        },
        "marks": {
          "$ref": "#/$defs/MarkPayloads"
        },
        "q01": {
          "$ref": "#/$defs/PositiveFloat"
        },
        "q10": {
          "$ref": "#/$defs/PositiveFloat"
        }
      },
      "required": [
        "q01",
        "q10",
        "lambda0",
        "lambda1",
        "marks"
      ],
      "title": "MmppPayload",
      "type": "object"
    },
    "NhppPayload": {
      "additionalProperties": false,
      "properties": {
        "bin_edges": {
          "$ref": "#/$defs/FloatVector"
        },
        "bin_marks": {
          "$ref": "#/$defs/MarkPayloadLists"
        },
        "global_marks": {
          "$ref": "#/$defs/MarkPayloads"
        },
        "integrated_intensity": {
          "$ref": "#/$defs/NonnegativeFloat"
        },
        "rates": {
          "$ref": "#/$defs/FloatVector"
        }
      },
      "required": [
        "bin_edges",
        "rates",
        "integrated_intensity",
        "bin_marks",
        "global_marks"
      ],
      "title": "NhppPayload",
      "type": "object"
    },
    "NonnegativeFloat": {
      "$ref": "#/$defs/ExactFloat",
      "ge": 0.0
    },
    "NonnegativeInt": {
      "minimum": 0,
      "type": "integer"
    },
    "PacketHmmCategories": {
      "items": {
        "$ref": "#/$defs/PacketHmmCategoryPayload"
      },
      "type": "array"
    },
    "PacketHmmCategoryPayload": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/DirectionName"
        },
        "iat_bin": {
          "maximum": 3,
          "minimum": 0,
          "title": "Iat Bin",
          "type": "integer"
        },
        "size_bin": {
          "maximum": 2,
          "minimum": 0,
          "title": "Size Bin",
          "type": "integer"
        }
      },
      "required": [
        "iat_bin",
        "direction",
        "size_bin"
      ],
      "title": "PacketHmmCategoryPayload",
      "type": "object"
    },
    "PacketHmmDiagnosticsPayload": {
      "additionalProperties": false,
      "properties": {
        "converged": {
          "const": true,
          "title": "Converged",
          "type": "boolean"
        },
        "iterations": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "log_likelihoods": {
          "$ref": "#/$defs/FloatVector"
        }
      },
      "required": [
        "converged",
        "iterations",
        "log_likelihoods"
      ],
      "title": "PacketHmmDiagnosticsPayload",
      "type": "object"
    },
    "PacketHmmPayload": {
      "additionalProperties": false,
      "properties": {
        "additive_smoothing": {
          "$ref": "#/$defs/ExactFloat",
          "const": 0.001
        },
        "convergence_tolerance": {
          "$ref": "#/$defs/ExactFloat",
          "const": 1e-08
        },
        "diagnostics": {
          "$ref": "#/$defs/PacketHmmDiagnosticsPayload"
        },
        "emission_rows": {
          "$ref": "#/$defs/FloatMatrix"
        },
        "iat_quantiles": {
          "const": [
            0.3333333333333333,
            0.6666666666666666
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/ExactFloat"
            },
            {
              "$ref": "#/$defs/ExactFloat"
            }
          ],
          "title": "Iat Quantiles",
          "type": "array"
        },
        "iat_thresholds": {
          "$ref": "#/$defs/FloatVector"
        },
        "initial_marks": {
          "$ref": "#/$defs/MarkPayloads"
        },
        "initial_probabilities": {
          "$ref": "#/$defs/FloatVector"
        },
        "initialization": {
          "const": "fixed_cyclic_v1",
          "title": "Initialization",
          "type": "string"
        },
        "maximum_iterations": {
          "const": 100,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "reservoirs": {
          "$ref": "#/$defs/PacketHmmReservoirs"
        },
        "size_quantiles": {
          "const": [
            0.3333333333333333,
            0.6666666666666666
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/ExactFloat"
            },
            {
              "$ref": "#/$defs/ExactFloat"
            }
          ],
          "title": "Size Quantiles",
          "type": "array"
        },
        "size_thresholds": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/ExactFloat"
            },
            {
              "$ref": "#/$defs/ExactFloat"
            }
          ],
          "title": "Size Thresholds",
          "type": "array"
        },
        "state_count": {
          "maximum": 4,
          "minimum": 2,
          "title": "State Count",
          "type": "integer"
        },
        "transition_rows": {
          "$ref": "#/$defs/FloatMatrix"
        },
        "vocabulary": {
          "$ref": "#/$defs/PacketHmmCategories"
        }
      },
      "required": [
        "additive_smoothing",
        "convergence_tolerance",
        "diagnostics",
        "emission_rows",
        "iat_quantiles",
        "iat_thresholds",
        "initial_marks",
        "initial_probabilities",
        "initialization",
        "maximum_iterations",
        "reservoirs",
        "size_quantiles",
        "size_thresholds",
        "state_count",
        "transition_rows",
        "vocabulary"
      ],
      "title": "PacketHmmPayload",
      "type": "object"
    },
    "PacketHmmReservoirs": {
      "items": {
        "$ref": "#/$defs/PacketHmmSamples"
      },
      "type": "array"
    },
    "PacketHmmSamplePayload": {
      "additionalProperties": false,
      "properties": {
        "frame_length": {
          "maximum": 4294967295,
          "minimum": 14,
          "title": "Frame Length",
          "type": "integer"
        },
        "iat": {
          "$ref": "#/$defs/NonnegativeFloat"
        }
      },
      "required": [
        "iat",
        "frame_length"
      ],
      "title": "PacketHmmSamplePayload",
      "type": "object"
    },
    "PacketHmmSamples": {
      "items": {
        "$ref": "#/$defs/PacketHmmSamplePayload"
      },
      "type": "array"
    },
    "PacketTrainPositionMarksPayload": {
      "additionalProperties": false,
      "properties": {
        "first": {
          "$ref": "#/$defs/MarkPayloads"
        },
        "interior": {
          "$ref": "#/$defs/MarkPayloads"
        },
        "last": {
          "$ref": "#/$defs/MarkPayloads"
        }
      },
      "required": [
        "first",
        "interior",
        "last"
      ],
      "title": "PacketTrainPositionMarksPayload",
      "type": "object"
    },
    "PacketTrainStatePayload": {
      "additionalProperties": false,
      "properties": {
        "actual_lengths": {
          "$ref": "#/$defs/IntVector"
        },
        "length_state": {
          "maximum": 8,
          "minimum": 1,
          "title": "Length State",
          "type": "integer"
        },
        "marks": {
          "$ref": "#/$defs/PacketTrainPositionMarksPayload"
        },
        "source_inter_train_gaps": {
          "$ref": "#/$defs/FloatVector"
        },
        "within_gaps": {
          "$ref": "#/$defs/PacketTrainWithinGapsPayload"
        }
      },
      "required": [
        "actual_lengths",
        "length_state",
        "marks",
        "source_inter_train_gaps",
        "within_gaps"
      ],
      "title": "PacketTrainStatePayload",
      "type": "object"
    },
    "PacketTrainStatePayloads": {
      "items": {
        "$ref": "#/$defs/PacketTrainStatePayload"
      },
      "type": "array"
    },
    "PacketTrainWithinGapsPayload": {
      "additionalProperties": false,
      "properties": {
        "interior": {
          "$ref": "#/$defs/FloatVector"
        },
        "last": {
          "$ref": "#/$defs/FloatVector"
        }
      },
      "required": [
        "interior",
        "last"
      ],
      "title": "PacketTrainWithinGapsPayload",
      "type": "object"
    },
    "PoissonPayload": {
      "additionalProperties": false,
      "properties": {
        "base_rate": {
          "$ref": "#/$defs/PositiveFloat"
        },
        "marks": {
          "$ref": "#/$defs/MarkPayloads"
        },
        "rate": {
          "$ref": "#/$defs/PositiveFloat"
        }
      },
      "required": [
        "base_rate",
        "rate",
        "marks"
      ],
      "title": "PoissonPayload",
      "type": "object"
    },
    "PositiveFloat": {
      "$ref": "#/$defs/ExactFloat",
      "gt": 0.0
    },
    "PositiveInt": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "TimingTierMatrix": {
      "items": {
        "$ref": "#/$defs/TimingTierVector"
      },
      "type": "array"
    },
    "TimingTierName": {
      "enum": [
        "transition",
        "source",
        "global"
      ],
      "type": "string"
    },
    "TimingTierVector": {
      "items": {
        "$ref": "#/$defs/TimingTierName"
      },
      "type": "array"
    },
    "TimingUsageCountsPayload": {
      "additionalProperties": false,
      "properties": {
        "global": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "source": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "transition": {
          "$ref": "#/$defs/NonnegativeInt"
        }
      },
      "required": [
        "global",
        "source",
        "transition"
      ],
      "title": "TimingUsageCountsPayload",
      "type": "object"
    }
  },
  "$id": "best_model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One fully self-contained, lineage-bound fitted traffic model.",
  "properties": {
    "capture_identity": {
      "$ref": "#/$defs/ContentIdentity"
    },
    "estimator_choices": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "title": "Estimator Choices",
      "type": "object"
    },
    "family": {
      "enum": [
        "poisson_empirical",
        "markov_renewal",
        "mmpp",
        "nhpp",
        "acd",
        "markov_packet_train",
        "packet_hmm"
      ],
      "title": "Family",
      "type": "string"
    },
    "final_limits": {
      "$ref": "#/$defs/GenerationLimits"
    },
    "final_seed": {
      "title": "Final Seed",
      "type": "integer"
    },
    "fitted": {
      "$ref": "#/$defs/FamilyPayload"
    },
    "gene_bounds": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/IntegerBounds"
          },
          {
            "$ref": "#/$defs/FloatBounds"
          }
        ]
      },
      "title": "Gene Bounds",
      "type": "object"
    },
    "genes": {
      "$ref": "#/$defs/Genes"
    },
    "observation_window_seconds": {
      "title": "Observation Window Seconds",
      "type": "number"
    },
    "reference_identity": {
      "$ref": "#/$defs/ContentIdentity"
    },
    "scientific_artifact_schema": {
      "const": 5,
      "title": "Scientific Artifact Schema",
      "type": "integer"
    },
    "seed_policy": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Seed Policy",
      "type": "object"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "scientific_artifact_schema",
    "family",
    "genes",
    "fitted",
    "reference_identity",
    "capture_identity",
    "final_seed",
    "final_limits",
    "observation_window_seconds",
    "gene_bounds",
    "estimator_choices",
    "seed_policy"
  ],
  "title": "BestModel",
  "type": "object"
}
