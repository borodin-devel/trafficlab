{
  "$defs": {
    "BestCandidateRecord": {
      "additionalProperties": false,
      "properties": {
        "fitness": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__checkpoint__schema__UnitFloat"
        },
        "identifier": {
          "$ref": "#/$defs/CandidateIdentifierRecord"
        }
      },
      "required": [
        "identifier",
        "fitness"
      ],
      "title": "BestCandidateRecord",
      "type": "object"
    },
    "C2stSettings": {
      "additionalProperties": false,
      "properties": {
        "feature_version": {
          "const": "window-v1",
          "title": "Feature Version",
          "type": "string"
        },
        "fold_count": {
          "minimum": 2,
          "title": "Fold Count",
          "type": "integer"
        },
        "guard_window_count": {
          "minimum": 0,
          "title": "Guard Window Count",
          "type": "integer"
        },
        "l2_regularization": {
          "exclusiveMinimum": 0,
          "title": "L2 Regularization",
          "type": "number"
        },
        "maximum_iterations": {
          "exclusiveMinimum": 0,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "maximum_window_count": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Maximum Window Count",
          "type": "integer"
        },
        "tolerance": {
          "exclusiveMinimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "window_width_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Width Seconds",
          "type": "number"
        }
      },
      "required": [
        "feature_version",
        "window_width_seconds",
        "fold_count",
        "guard_window_count",
        "maximum_window_count",
        "l2_regularization",
        "maximum_iterations",
        "tolerance"
      ],
      "title": "C2stSettings",
      "type": "object"
    },
    "CandidateFailureRecord": {
      "discriminator": {
        "mapping": {
          "fit": "#/$defs/FitFailure",
          "generation": "#/$defs/GenerationFailure",
          "incomplete_generation": "#/$defs/IncompleteGenerationFailure",
          "nonfinite_score": "#/$defs/NonfiniteScoreFailure",
          "repair": "#/$defs/RepairFailure",
          "similarity_precondition": "#/$defs/SimilarityPreconditionFailure"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RepairFailure"
        },
        {
          "$ref": "#/$defs/FitFailure"
        },
        {
          "$ref": "#/$defs/GenerationFailure"
        },
        {
          "$ref": "#/$defs/IncompleteGenerationFailure"
        },
        {
          "$ref": "#/$defs/SimilarityPreconditionFailure"
        },
        {
          "$ref": "#/$defs/NonfiniteScoreFailure"
        }
      ]
    },
    "CandidateIdentifierRecord": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/NonnegativeInt"
        },
        {
          "$ref": "#/$defs/NonnegativeInt"
        }
      ],
      "type": "array"
    },
    "CandidateRecord": {
      "discriminator": {
        "mapping": {
          "invalid": "#/$defs/InvalidCandidateRecord",
          "pending": "#/$defs/PendingCandidateRecord",
          "valid": "#/$defs/ValidCandidateRecord"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PendingCandidateRecord"
        },
        {
          "$ref": "#/$defs/ValidCandidateRecord"
        },
        {
          "$ref": "#/$defs/InvalidCandidateRecord"
        }
      ]
    },
    "ContentIdentityRecord": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/NonnegativeInt"
        }
      },
      "required": [
        "size",
        "sha256"
      ],
      "title": "ContentIdentityRecord",
      "type": "object"
    },
    "CoordinateRecord": {
      "discriminator": {
        "mapping": {
          "integer": "#/$defs/IntegerCoordinateRecord",
          "linear": "#/$defs/LinearCoordinateRecord",
          "log": "#/$defs/LogCoordinateRecord"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LinearCoordinateRecord"
        },
        {
          "$ref": "#/$defs/LogCoordinateRecord"
        },
        {
          "$ref": "#/$defs/IntegerCoordinateRecord"
        }
      ]
    },
    "DispersionSettings": {
      "additionalProperties": false,
      "properties": {
        "allan_weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Allan Weight",
          "type": "number"
        },
        "fano_weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fano Weight",
          "type": "number"
        },
        "scale_weights": {
          "items": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Scale Weights",
          "type": "array"
        },
        "widths_seconds": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Widths Seconds",
          "type": "array"
        }
      },
      "required": [
        "widths_seconds",
        "scale_weights",
        "fano_weight",
        "allan_weight"
      ],
      "title": "DispersionSettings",
      "type": "object"
    },
    "DuplicateDiagnostic": {
      "additionalProperties": false,
      "description": "One bounded duplicate-retry decision.",
      "properties": {
        "attempt": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "detail": {
          "$ref": "#/$defs/NonemptyString"
        },
        "outcome": {
          "$ref": "#/$defs/DuplicateOutcome"
        }
      },
      "required": [
        "attempt",
        "outcome",
        "detail"
      ],
      "title": "DuplicateDiagnostic",
      "type": "object"
    },
    "DuplicateOutcome": {
      "enum": [
        "invalid",
        "duplicate",
        "exhausted"
      ],
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "not_published",
        "diagnostic_only",
        "preserved",
        "possibly_remaining"
      ],
      "type": "string"
    },
    "ExactFloat": {
      "type": "number"
    },
    "FailureAuthority": {
      "enum": [
        "primary",
        "secondary"
      ],
      "type": "string"
    },
    "FamilyCheckpointRecord": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "$ref": "#/$defs/CoordinateRecord"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "gene_order": {
          "items": {
            "$ref": "#/$defs/NonemptyString"
          },
          "minItems": 1,
          "title": "Gene Order",
          "type": "array"
        },
        "name": {
          "enum": [
            "poisson_empirical",
            "markov_renewal",
            "mmpp",
            "nhpp",
            "acd",
            "markov_packet_train",
            "packet_hmm"
          ],
          "title": "Name",
          "type": "string"
        },
        "operators": {
          "$ref": "#/$defs/FamilyOperatorsRecord"
        }
      },
      "required": [
        "name",
        "gene_order",
        "coordinates",
        "operators"
      ],
      "title": "FamilyCheckpointRecord",
      "type": "object"
    },
    "FamilyOperatorsRecord": {
      "additionalProperties": false,
      "properties": {
        "crossover_probability": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__checkpoint__schema__UnitFloat"
        },
        "mutation_probability": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__checkpoint__schema__UnitFloat"
        },
        "mutation_scale": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__checkpoint__schema__UnitFloat",
          "gt": 0.0
        }
      },
      "required": [
        "crossover_probability",
        "mutation_probability",
        "mutation_scale"
      ],
      "title": "FamilyOperatorsRecord",
      "type": "object"
    },
    "FamilyPriority": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "FitFailure": {
      "additionalProperties": false,
      "properties": {
        "affected_evidence": {
          "$ref": "#/$defs/NonemptyString"
        },
        "authority": {
          "$ref": "#/$defs/FailureAuthority"
        },
        "corrective_action": {
          "$ref": "#/$defs/NonemptyString"
        },
        "detail": {
          "$ref": "#/$defs/NonemptyString"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "kind": {
          "const": "fit",
          "title": "Kind",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonnegativeInt"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "$ref": "#/$defs/NonemptyString"
        }
      },
      "required": [
        "seed",
        "detail",
        "stage",
        "affected_evidence",
        "evidence_state",
        "corrective_action",
        "authority",
        "kind"
      ],
      "title": "FitFailure",
      "type": "object"
    },
    "Gene": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        }
      ]
    },
    "GenerationFailure": {
      "additionalProperties": false,
      "properties": {
        "affected_evidence": {
          "$ref": "#/$defs/NonemptyString"
        },
        "authority": {
          "$ref": "#/$defs/FailureAuthority"
        },
        "corrective_action": {
          "$ref": "#/$defs/NonemptyString"
        },
        "detail": {
          "$ref": "#/$defs/NonemptyString"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "kind": {
          "const": "generation",
          "title": "Kind",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonnegativeInt"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "$ref": "#/$defs/NonemptyString"
        }
      },
      "required": [
        "seed",
        "detail",
        "stage",
        "affected_evidence",
        "evidence_state",
        "corrective_action",
        "authority",
        "kind"
      ],
      "title": "GenerationFailure",
      "type": "object"
    },
    "GenerationLimits": {
      "additionalProperties": false,
      "properties": {
        "max_output_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_packets": {
          "exclusiveMinimum": 0,
          "title": "Max Packets",
          "type": "integer"
        },
        "max_wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "max_packets",
        "max_output_bytes",
        "max_wall_seconds"
      ],
      "title": "GenerationLimits",
      "type": "object"
    },
    "Genes": {
      "items": {
        "$ref": "#/$defs/Gene"
      },
      "type": "array"
    },
    "GeneticCheckpointSettings": {
      "additionalProperties": false,
      "description": "All genetic settings that can alter selection, reproduction, or termination.",
      "properties": {
        "duplicate_mutation_attempts": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "early_stopping_generations": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "early_stopping_tolerance": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__checkpoint__schema__UnitFloat"
        },
        "elite_count": {
          "$ref": "#/$defs/PositiveInt"
        },
        "final_seed": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "generation_count": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "master_seed": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "population_size": {
          "minimum": 2,
          "title": "Population Size",
          "type": "integer"
        },
        "resume": {
          "title": "Resume",
          "type": "boolean"
        },
        "tournament_size": {
          "minimum": 2,
          "title": "Tournament Size",
          "type": "integer"
        }
      },
      "required": [
        "master_seed",
        "final_seed",
        "population_size",
        "generation_count",
        "tournament_size",
        "elite_count",
        "duplicate_mutation_attempts",
        "early_stopping_generations",
        "early_stopping_tolerance",
        "resume"
      ],
      "title": "GeneticCheckpointSettings",
      "type": "object"
    },
    "HistoryRecord": {
      "additionalProperties": false,
      "properties": {
        "best_fitness": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__checkpoint__schema__UnitFloat"
        },
        "best_identifier": {
          "$ref": "#/$defs/CandidateIdentifierRecord"
        },
        "candidate_count": {
          "$ref": "#/$defs/PositiveInt"
        },
        "family": {
          "anyOf": [
            {
              "enum": [
                "poisson_empirical",
                "markov_renewal",
                "mmpp",
                "nhpp",
                "acd",
                "markov_packet_train",
                "packet_hmm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Family"
        },
        "generation": {
          "$ref": "#/$defs/NonnegativeInt"
        },
        "mean_fitness": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__checkpoint__schema__UnitFloat"
        },
        "scope": {
          "enum": [
            "family",
            "overall"
          ],
          "title": "Scope",
          "type": "string"
        },
        "valid_count": {
          "$ref": "#/$defs/NonnegativeInt"
        }
      },
      "required": [
        "generation",
        "scope",
        "family",
        "candidate_count",
        "valid_count",
        "best_fitness",
        "mean_fitness",
        "best_identifier"
      ],
      "title": "HistoryRecord",
      "type": "object"
    },
    "IncompleteGenerationFailure": {
      "additionalProperties": false,
      "properties": {
        "affected_evidence": {
          "$ref": "#/$defs/NonemptyString"
        },
        "authority": {
          "$ref": "#/$defs/FailureAuthority"
        },
        "corrective_action": {
          "$ref": "#/$defs/NonemptyString"
        },
        "detail": {
          "$ref": "#/$defs/NonemptyString"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "kind": {
          "const": "incomplete_generation",
          "title": "Kind",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonnegativeInt"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "$ref": "#/$defs/NonemptyString"
        }
      },
      "required": [
        "seed",
        "detail",
        "stage",
        "affected_evidence",
        "evidence_state",
        "corrective_action",
        "authority",
        "kind"
      ],
      "title": "IncompleteGenerationFailure",
      "type": "object"
    },
    "IntegerCoordinateRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "integer"
        },
        "name": {
          "$ref": "#/$defs/NonemptyString"
        },
        "upper": {
          "title": "Upper",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "kind",
        "lower",
        "upper"
      ],
      "title": "IntegerCoordinateRecord",
      "type": "object"
    },
    "InvalidCandidateRecord": {
      "additionalProperties": false,
      "properties": {
        "duplicate_diagnostics": {
          "items": {
            "$ref": "#/$defs/DuplicateDiagnostic"
          },
          "title": "Duplicate Diagnostics",
          "type": "array"
        },
        "family": {
          "enum": [
            "poisson_empirical",
            "markov_renewal",
            "mmpp",
            "nhpp",
            "acd",
            "markov_packet_train",
            "packet_hmm"
          ],
          "title": "Family",
          "type": "string"
        },
        "fitness": {
          "$ref": "#/$defs/ExactFloat",
          "ge": 0.0,
          "le": 0.0
        },
        "genes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Genes"
            },
            {
              "type": "null"
            }
          ]
        },
        "identifier": {
          "$ref": "#/$defs/CandidateIdentifierRecord"
        },
        "invalid": {
          "$ref": "#/$defs/CandidateFailureRecord"
        },
        "status": {
          "const": "invalid",
          "title": "Status",
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/TrialResult"
          },
          "title": "Trials",
          "type": "array"
        }
      },
      "required": [
        "identifier",
        "family",
        "fitness",
        "trials",
        "duplicate_diagnostics",
        "genes",
        "status",
        "invalid"
      ],
      "title": "InvalidCandidateRecord",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "LinearCoordinateRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "linear",
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "$ref": "#/$defs/ExactFloat"
        },
        "name": {
          "$ref": "#/$defs/NonemptyString"
        },
        "upper": {
          "$ref": "#/$defs/ExactFloat"
        }
      },
      "required": [
        "name",
        "kind",
        "lower",
        "upper"
      ],
      "title": "LinearCoordinateRecord",
      "type": "object"
    },
    "LogCoordinateRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "log",
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "$ref": "#/$defs/PositiveFloat"
        },
        "name": {
          "$ref": "#/$defs/NonemptyString"
        },
        "upper": {
          "$ref": "#/$defs/PositiveFloat"
        }
      },
      "required": [
        "name",
        "kind",
        "lower",
        "upper"
      ],
      "title": "LogCoordinateRecord",
      "type": "object"
    },
    "MethodName": {
      "enum": [
        "autocorrelation",
        "frame_size_ks",
        "iat_ks",
        "multiscale_rate",
        "cramer_von_mises",
        "anderson_darling",
        "jensen_shannon",
        "approximate_mmd"
      ],
      "type": "string"
    },
    "MethodTrialResult": {
      "additionalProperties": false,
      "description": "One named similarity result retained with recursively frozen diagnostics.",
      "properties": {
        "diagnostics": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Diagnostics",
          "type": "object"
        },
        "name": {
          "$ref": "#/$defs/MethodName"
        },
        "score": {
          "$ref": "#/$defs/trafficlab__fitting__genetic__types__UnitFloat"
        }
      },
      "required": [
        "name",
        "score",
        "diagnostics"
      ],
      "title": "MethodTrialResult",
      "type": "object"
    },
    "MethodWeights": {
      "additionalProperties": false,
      "properties": {
        "anderson_darling": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anderson Darling",
          "type": "number"
        },
        "approximate_mmd": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Approximate Mmd",
          "type": "number"
        },
        "autocorrelation": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Autocorrelation",
          "type": "number"
        },
        "cramer_von_mises": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cramer Von Mises",
          "type": "number"
        },
        "frame_size_ks": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Frame Size Ks",
          "type": "number"
        },
        "iat_ks": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Iat Ks",
          "type": "number"
        },
        "jensen_shannon": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Jensen Shannon",
          "type": "number"
        },
        "multiscale_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Multiscale Rate",
          "type": "number"
        }
      },
      "required": [
        "frame_size_ks",
        "iat_ks",
        "autocorrelation",
        "multiscale_rate",
        "cramer_von_mises",
        "anderson_darling",
        "jensen_shannon",
        "approximate_mmd"
      ],
      "title": "MethodWeights",
      "type": "object"
    },
    "ModelDiagnostics": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "NamedRngState": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "numpy.random.Generator/PCG64",
          "title": "Engine",
          "type": "string"
        },
        "python_version": {
          "$ref": "#/$defs/NonemptyString"
        },
        "state": {
          "$ref": "#/$defs/RngState"
        }
      },
      "required": [
        "engine",
        "python_version",
        "state"
      ],
      "title": "NamedRngState",
      "type": "object"
    },
    "NonemptyString": {
      "minLength": 1,
      "type": "string"
    },
    "NonfiniteScoreFailure": {
      "additionalProperties": false,
      "properties": {
        "affected_evidence": {
          "$ref": "#/$defs/NonemptyString"
