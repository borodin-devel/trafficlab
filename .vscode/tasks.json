{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Run Ruff check",
      "type": "shell",
      "command": "uv run ruff check src tests",
      "problemMatcher": [
        {
          "owner": "python",
          "pattern": {
            "regexp": "^(?:  )?([^:]+):(\\d+):(\\d+): ([A-Z]\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          }
        }
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Python: Run Ruff format",
      "type": "shell",
      "command": "uv run ruff format src tests",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Python: Run Pyright strict check",
      "type": "shell",
      "command": "uv run pyright",
      "group": "build",
      "problemMatcher": [
        {
          "owner": "python",
          "pattern": {
            "regexp": "^(?:  )?([^:]+):(\\d+): (\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Python: Export Pyright JSON report",
      "type": "shell",
      "command": "uv run pyright --outputjson > .vscode/pylance-report.json",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Python: Run tests",
      "type": "shell",
      "command": "uv run pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Python: Run strict verification",
      "type": "shell",
      "dependsOn": [
        "Python: Run Ruff check",
        "Python: Run Pyright strict check",
        "Python: Run tests"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "dependsOrder": "sequence"
    }
  ]
}
